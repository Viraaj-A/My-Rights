# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
# Main app database (display_cases etc.). On Hetzner this is the local Postgres container.
SQLALCHEMY_DATABASE_URI=postgresql://myrights:<postgres-password>@db:5432/raw_data_db
# Used by plotly_dash, all_cases.py, questionnaire_cases.py. Format: user:password@host:port/dbname
CONNECTION_STRING=myrights:<postgres-password>@db:5432/raw_data_db
DB_SSLMODE=prefer
# Password for the Postgres container (docker-compose.yml substitutes it)
POSTGRES_PASSWORD=<postgres-password>
# Scraper scripts under scraping_files/ (not scheduled on Hetzner)
SCRAPER_DB_HOST=db
SCRAPER_DB_USER=myrights
SCRAPER_DB_PASSWORD=<postgres-password>
SCRAPER_DB_PORT=5432
# Scrapers default to sslmode=require. The local Postgres container has no TLS, so set
# "prefer" only when SCRAPER_DB_HOST is the container; keep "require" (or verify-full) for any remote host.
SCRAPER_DB_SSLMODE=prefer
MISTRAL_API_KEY=<mistral-key>
